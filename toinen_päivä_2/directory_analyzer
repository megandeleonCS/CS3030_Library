# Exit immediately if a command exits with a non-zero status or on unbound variable
set -euo pipefail

# Global Default Variables
VERBOSE=false
TARGET_DIR=""

# ------------------------------------------------------------------------------
# Function: display_usage
# Description: Prints usage instructions and exits
# ------------------------------------------------------------------------------
display_usage() {
    echo "Usage: $0 [-h] [-v] <target_directory>"
    echo "  -h  Display help menu"
    echo "  -v  Enable verbose output"
}

# ==============================================================================
# TODO 1: Argument Parsing and Flag Handling
# ==============================================================================
# Use getopts or manual flag checking ($1, shift) to parse parameters:
# - Handle '-h' to call display_usage and exit with code 0.
# - Handle '-v' to set VERBOSE=true.
# - Assign the target directory argument to TARGET_DIR.
# - Exit with status code 1 if no directory parameter is supplied.

parse_arguments() {
    # TODO 1: Implement argument parsing logic here
    while getopts "hv" opt; do
        case ${opt} in
            h )
                display_usage
                exit 0
                ;;
            v )
                VERBOSE=true
                ;;
            \? )
                display_usage
                exit 1
                ;;
        esac
    done
    shift $((OPTIND -1))

    # TODO 1: Check if positional argument for directory exists
    if [ $# -eq 0 ]; then
        echo "Error: Missing target directory argument." >&2
        display_usage
        exit 1
    fi

    TARGET_DIR="$1"
}


