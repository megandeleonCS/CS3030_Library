# - Inspect sys.executable (path to Python interpreter) and sys.prefix (active venv)
# - Print a warning if running outside a virtual environment (sys.prefix == sys.base_prefix)
def verify_environment():
    env_mode = os.environ.get("ARCHIVER_ENV", "development")
    print(f"[*] Environment Mode: {env_mode}")
    print(f"[*] Executable Path: {sys.executable}")
    print(f"[*] Environment Prefix: {sys.prefix}")
    
    if sys.prefix == getattr(sys, "base_prefix", sys.prefix):
        print("[!] Warning: Script is running outside of an active virtual environment!")


