# TODO 2: Signal Handling (SIGINT / SIGTERM)
# ==============================================================================
# Register a custom handler for signal.SIGINT (Ctrl+C):
# - Check if global TEMP_DIR exists and delete it using shutil.rmtree() if present.
# - Output a graceful exit message to stderr and call sys.exit(130).
def handle_sigint(signum, frame):
    global TEMP_DIR
    print("\n[!] Interruption signal received (SIGINT). Cleaning up...", file=sys.stderr)
    if TEMP_DIR and TEMP_DIR.exists():
        shutil.rmtree(TEMP_DIR, ignore_errors=True)
        print(f"[*] Cleaned up staging directory: {TEMP_DIR}", file=sys.stderr)
    sys.exit(130)


