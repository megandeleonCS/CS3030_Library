# ==============================================================================
# TODO 4: CLI Design & Safe Arguments (argparse)
# ==============================================================================
# Construct an ArgumentParser object:
# - Add argument '--source' / '-s': Path to scan (type=Path, required=True).
# - Add argument '--pattern' / '-p': Glob pattern (default="*.txt").
# - Add argument '--output'  / '-o': Output zip file name (default="archive").
# - Validate that the provided source path exists and is a directory.
def parse_cli_args():
    parser = argparse.ArgumentParser(
        description="Production utility to safely scan and archive workspace files."
    )
    
    # TODO 4: Add arguments and perform type/existence validation
    parser.add_argument("-s", "--source", type=Path, required=True, help="Directory path to scan")
    parser.add_argument("-p", "--pattern", type=str, default="*.txt", help="Search pattern (e.g. *.log)")
    parser.add_argument("-o", "--output", type=str, default="archive", help="Name of output zip file")

    args = parser.parse_args()

    if not args.source.exists() or not args.source.is_dir():
        parser.error(f"Provided source path '{args.source}' is not a valid directory.")

    return args


def main():
    # Attach signal handler
