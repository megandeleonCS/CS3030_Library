#!/bin/bash
# Lab 01: Conditionals and Logic Practice (Solution)
# Topics: if/elif/else, test operators, case statements, functions

# set -euo pipefail

# ==============================================================================
# 1: File Checker Function
# ==============================================================================
check_file() {
    local filepath="$1"
    
    if [ ! -e "$filepath" ] && [ ! -L "$filepath" ]; then
        echo "Error: Path '$filepath' does not exist."
        return 1
    fi

    echo "--- Properties for: $filepath ---"
    
    # Type checks
    [ -L "$filepath" ] && echo "Type: Symbolic Link"
    [ -f "$filepath" ] && echo "Type: Regular File"
    [ -d "$filepath" ] && echo "Type: Directory"
    
    # Permission checks
    [ -r "$filepath" ] && echo "Permissions: Readable" || echo "Permissions: Not Readable"
    [ -w "$filepath" ] && echo "Permissions: Writable" || echo "Permissions: Not Writable"
    [ -x "$filepath" ] && echo "Permissions: Executable" || echo "Permissions: Not Executable"
}

# ==============================================================================
# 2: Integer & Network Port Validator
# ==============================================================================
validate_number_and_port() {
    local input="$1"
    
    # Validate regex match for integer
    if [[ ! "$input" =~ ^-?[0-9]+$ ]]; then
        echo "Error: '$input' is not a valid integer."
        return 1
    fi
    echo "Valid integer detected: $input"

    # Evaluate numerical port ranges
    if [ "$input" -ge 1 ] && [ "$input" -le 1023 ]; then
        echo "Port Category: Well-known (1-1023)"
    elif [ "$input" -ge 1024 ] && [ "$input" -le 49151 ]; then
        echo "Port Category: Registered (1024-49151)"
    elif [ "$input" -ge 49152 ] && [ "$input" -le 65535 ]; then
        echo "Port Category: Dynamic/Private (49152-65535)"
    else
        echo "Port Category: Out of valid network range (1-65535) or negative."
    fi
}

# ==============================================================================
# 3: Backup Decision Function
# ==============================================================================
should_backup() {
    local filepath="$1"
    
    # Compound checks: Exists (-e), Readable (-r), Non-empty (-s)
    if [ -e "$filepath" ] && [ -r "$filepath" ] && [ -s "$filepath" ]; then
        # Check if modified in the last 24 hours (-mtime -1)
        if find "$filepath" -mtime -1 | grep -q .; then
            echo "Result: Backup REQUIRED. File is readable, non-empty, and recently modified."
            return 0
        fi
    fi
    
    echo "Result: Backup SKIPPED. File does not meet archival criteria."
    return 1
}

# ==============================================================================
# 4: Environment Auditor
# ==============================================================================
validate_environment() {
    echo "=== Running Environment Audit ==="
    
    # Check required binaries
    for cmd in git bash; do
        if command -v "$cmd" >/dev/null 2>&1; then
            echo "[OK] Command found: $cmd"
        else
            echo "[FAIL] Command missing: $cmd"
        fi
    done

    # Check environment variables
    if [ -n "$HOME" ] && [ -n "$USER" ]; then
        echo "[OK] Essential environment variables (\$HOME, \$USER) are present."
    else
        echo "[FAIL] Missing \$HOME or \$USER variables."
    fi

    # Verify major Bash version
    if [ "${BASH_VERSINFO[0]}" -ge 4 ]; then
        echo "[OK] Bash version is >= 4 (${BASH_VERSION})"
    else
        echo "[WARNING] Bash version is < 4 (${BASH_VERSION}). Some modern features may fail."
    fi
}

# ==============================================================================
# 5: User Permission Checker
# ==============================================================================
check_permissions() {
    local username="${1:-$USER}"
    
    if [ "$EUID" -eq 0 ]; then
        echo "Security Context: User '$username' has ROOT (EUID 0) privileges."
    elif groups "$username" 2>/dev/null | grep -qE '\b(sudo|wheel)\b'; then
        echo "Security Context: User '$username' has SUDO/Admin privileges."
    else
        echo "Security Context: User '$username' has STANDARD privileges."
    fi
}

# ==============================================================================
# 6: Deployment Profile Selector
# ==============================================================================
select_deployment_env() {
    local env="$1"
    
    case "$env" in
        "dev")
            DB_HOST="localhost"
            API_URL="http://127.0.0.1:8080"
            LOG_LEVEL="debug"
            ;;
        "staging")
            DB_HOST="db.staging.local"
            API_URL="https://api.staging.internal"
            LOG_LEVEL="info"
            ;;
        "prod")
            DB_HOST="db.production.cluster"
            API_URL="https://api.production.com"
            LOG_LEVEL="error"
            ;;
        *)
            echo "Invalid environment '$env'. Use: dev, staging, prod"
            return 1
            ;;
    esac
    
    echo "Environment loaded: $env"
    echo "--> Host: $DB_HOST | API: $API_URL | Log Level: $LOG_LEVEL"
}

# ==============================================================================
# MAIN INTERACTIVE DASHBOARD
# ==============================================================================
main() {
    while true; do
        echo "=========================================="
        echo "     Conditionals & Logic Dashboard       "
        echo "=========================================="
        echo "1. Verify File Properties"
        echo "2. Validate Integer / Port Number"
        echo "3. Evaluate File Backup Status"
        echo "4. Audit System Environment"
        echo "5. Check User Security Context"
        echo "6. Load Deployment Profile"
        echo "7. Exit"
        echo ""
        read -p "Select an option (1-7): " choice
        echo ""
        
        case "$choice" in
            1)
                read -p "Enter file path: " fp
                check_file "$fp"
                ;;
            2)
                read -p "Enter number/port: " num
                validate_number_and_port "$num"
                ;;
            3)
                read -p "Enter target path: " fp
                should_backup "$fp"
                ;;
            4)
                validate_environment
                ;;
            5)
                check_permissions "$USER"
                ;;
            6)
                read -p "Enter environment (dev/staging/prod): " env_choice
                select_deployment_env "$env_choice"
                ;;
            7)
                echo "Exiting..."
                exit 0
                ;;
            *)
                echo "Invalid selection. Please choose 1-7."
                ;;
        esac
        echo ""
    done
}

# Execute main function
main