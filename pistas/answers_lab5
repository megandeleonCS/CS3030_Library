#!/bin/bash
# Lab 03: Wildcards and Pattern Matching Practice (Solution)
# Topics: Globbing (*, ?, []), Brace Expansion ({}), Parameter Expansion

WORKSPACE="lab3_workspace"

# ==============================================================================
# 1: Environment Setup
# ==============================================================================
setup_test_files() {
    echo "Setting up test environment workspace..."
    
    # Create target directories using brace expansion
    mkdir -p "$WORKSPACE"/{logs,backups,reports,data}
    
    # Populate test files using brace expansion
    touch "$WORKSPACE"/reports/report_2025_{01..06}.txt
    touch "$WORKSPACE"/data/data.{csv,json,xml}
    
    # Populate log files with actual line entries for analysis
    echo -e "Error: Connection timeout\nError: Disk full\nError: Access denied" > "$WORKSPACE/logs/log_error.txt"
    echo -e "Warning: High CPU usage" > "$WORKSPACE/logs/log_warning.txt"
    echo -e "Info: Service started\nInfo: User logged in" > "$WORKSPACE/logs/log_info.txt"
    
    echo "Workspace population complete."
}

# ==============================================================================
# 2: Pattern Matching & Filtering
# ==============================================================================
practice_wildcards() {
    echo "=== Wildcard Pattern Matching ==="
    
    echo "1. All .txt files in reports:"
    ls "$WORKSPACE"/reports/*.txt 2>/dev/null || true
    echo ""

    echo "2. Reports for months 01 through 03 using character range [...]:"
    ls "$WORKSPACE"/reports/report_2025_0[1-3].txt 2>/dev/null || true
    echo ""

    echo "3. Single character wildcard (?) for month digits:"
    ls "$WORKSPACE"/reports/report_2025_??.txt 2>/dev/null || true
}

# ==============================================================================
# 3: Brace Expansion Showcase
# ==============================================================================
practice_brace_expansion() {
    echo "=== Brace Expansion Examples ==="
    
    echo "Numeric range 1 through 10:"
    echo {1..10}
    echo ""

    echo "Step sequence 0 through 50 by 10s:"
    echo {0..50..10}
    echo ""

    echo "Combined matrix sequence {A,B}{1,2}:"
    echo {A,B}{1,2}
}

# ==============================================================================
# 4: Log File Line Counter
# ==============================================================================
analyze_logs() {
    echo "=== Log File Analysis ==="
    
    # Check if target files exist using glob expansion
    if ls "$WORKSPACE"/logs/log_*.txt >/dev/null 2>&1; then
        echo "Line counts for log files matching 'log_*.txt':"
        wc -l "$WORKSPACE"/logs/log_*.txt
    else
        echo "No log files matching pattern 'log_*.txt' were found."
    fi
}

# ==============================================================================
# 5: Bulk File Extension Changer
# ==============================================================================
bulk_rename() {
    echo "=== Bulk Extension Rename (.txt -> .bak) ==="
    
    # Loop over all matching files in the reports folder
    for file in "$WORKSPACE"/reports/*.txt; do
        # Guard against unexpanded globs when no matching files exist
        [ -e "$file" ] || continue
        
        # Strip suffix .txt and append .bak using parameter expansion
        new_file="${file%.txt}.bak"
        
        mv "$file" "$new_file"
        echo "Renamed: $(basename "$file") -> $(basename "$new_file")"
    done
}

# ==============================================================================
# MAIN ORCHESTRATION
# ==============================================================================
main() {
    echo "============================================"
    echo "  Wildcards and Pattern Matching Practice   "
    echo "============================================"
    echo ""
    
    setup_test_files
    echo ""
    practice_wildcards
    echo ""
    practice_brace_expansion
    echo ""
    analyze_logs
    echo ""
    bulk_rename
    echo ""
    echo "Exercise sequence complete!"
}

# Execute script orchestration
main