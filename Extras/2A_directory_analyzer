# ==============================================================================
# - Use getopts to parse options:
#     - '-h' : Call display_usage and exit with code 0.
#     - '-v' : Set VERBOSE=true.
#     - Unknown options ('\?') : Call display_usage and exit with code 1.
# - Shift arguments past parsed options.
# - Verify that a target directory positional argument was provided ($# -eq 0).
# - Assign the directory parameter to TARGET_DIR.

parse_arguments() {
    while getopts "hv" opt; do
        case ${opt} in
            h )
                display_usage
                exit 0
                ;;
            v )
                VERBOSE=true
                ;;
            \? )
                display_usage
                exit 1
                ;;
        esac
    done
    shift $((OPTIND - 1))

